# Discord Webhook URL (required)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# WebSocket URL for Qubic logs (optional, has default)
WebSocketUrls__0=ws://server1:40420/ws/logs
WebSocketUrls__1=ws://server2:40420/ws/logs

# Bundle JSON URL for address labels (optional, has default)
BUNDLE_JSON_URL=https://static.qubic.org/v1/general/data/bundle.json

# Minimum transfer amount to trigger notification (optional, default: 1000000)
MIN_TRANSFER_AMOUNT=2000000000

# Reconnect delay in seconds (optional, default: 5)
RECONNECT_DELAY_SECONDS=5

# max tick delay a connected websocket server may have
MaxTickDelay=10
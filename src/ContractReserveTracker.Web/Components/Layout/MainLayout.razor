@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <span class="status-dot online"></span>
            <span class="text-muted small">Connected</span>
            <a href="https://qubic.org" target="_blank">Qubic.org</a>
        </div>

        <div class="disclaimer-banner">
            <span class="warning-icon">&#9888;</span>
            <span><strong>Disclaimer:</strong> This application is currently in beta status. I do not guarantee the completeness, accuracy, or availability of the captured data. Use it for demonstration and analysis purposes only.</span>
        </div>

        <article class="content px-4">
            @Body
        </article>

        <footer class="site-footer">
            <div class="footer-links">
                <a href="https://qubic.org" target="_blank">Qubic.org</a>
                <span class="separator">|</span>
                <a href="https://github.com/qubic" target="_blank">GitHub</a>
            </div>
            <p class="copyright">© 2025 Reserve Tracker <span class="version">v1.0.0 (BETA)</span></p>
        </footer>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@page "/"
@rendermode InteractiveServer
@using ContractReserveTracker.Shared.Models
@using ContractReserveTracker.Shared.Services
@using ContractReserveTracker.Web.Services
@using Microsoft.AspNetCore.SignalR.Client
@inject ReserveService ReserveService
@inject IContractInfoService ContractInfoService
@inject NavigationManager NavigationManager
@implements IAsyncDisposable

<PageTitle>Contract Reserve Tracker</PageTitle>

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="mb-1" style="font-size: 1.75rem; font-weight: 700;">Contract Reserves</h1>
            <p class="text-muted mb-0">Real-time tracking of Qubic smart contract reserves</p>
        </div>
        <div class="text-end">
            <span class="badge bg-info">Epoch @_currentEpoch</span>
        </div>
    </div>

    <!-- Stats Overview -->
    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-label">Total Contracts</div>
                <div class="stat-value">@_snapshots.Count</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-label">Total Burned</div>
                <div class="stat-value text-success" style="color: var(--qubic-green) !important;">+@FormatAmount(_totalBurned)</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-label">Total Deducted</div>
                <div class="stat-value text-danger" style="color: var(--qubic-red) !important;">-@FormatAmount(_totalDeducted)</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-label">Net Reserve Change</div>
                <div class="stat-value" style="color: @(_netChange >= 0 ? "var(--qubic-green)" : "var(--qubic-red)") !important;">
                    @((_netChange >= 0 ? "+" : "") + FormatAmount(_netChange))
                </div>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-danger">
            <strong>Error:</strong> @_error
        </div>
    }
    else if (_loading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="text-muted mt-3">Loading contract data...</p>
        </div>
    }
    else if (_snapshots.Count == 0)
    {
        <div class="alert alert-info d-flex align-items-center">
            <span class="pulse me-2" style="font-size: 1.5rem;">📡</span>
            <div>
                <strong>Waiting for events...</strong>
                <p class="mb-0 small">The collector is connected and listening for burn and deduction events.</p>
            </div>
        </div>
    }
    else
    {
        <!-- Contract Cards Grid -->
        <div class="section-header">
            <h4>Active Contracts</h4>
            <span class="badge bg-primary">@_snapshots.Count contracts</span>
        </div>

        <div class="row g-3 mb-4">
            @foreach (var snapshot in _snapshots)
            {
                <div class="col-lg-4 col-md-6">
                    <div class="card h-100">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <strong>@snapshot.ContractName</strong>
                            <span class="badge bg-info">#@snapshot.ContractIndex</span>
                        </div>
                        <div class="card-body">
                            <div class="mb-3">
                                <div class="stat-label">Current Reserve</div>
                                <div class="stat-value" style="font-size: 1.5rem;">@FormatAmount(snapshot.CurrentReserve) <span class="text-muted" style="font-size: 0.875rem;">QU</span></div>
                            </div>
                            <div class="row g-2">
                                <div class="col-6">
                                    <div class="small text-muted">Burned</div>
                                    <div class="text-success mono">+@FormatAmount(snapshot.TotalBurned)</div>
                                    <div class="text-muted small">@snapshot.BurnCount events</div>
                                </div>
                                <div class="col-6">
                                    <div class="small text-muted">Deducted</div>
                                    <div class="text-danger mono">-@FormatAmount(snapshot.TotalDeducted)</div>
                                    <div class="text-muted small">@snapshot.DeductCount events</div>
                                </div>
                            </div>
                            @if (snapshot.LastEventTime.HasValue)
                            {
                                <div class="mt-3 pt-3" style="border-top: 1px solid var(--qubic-border);">
                                    <small class="text-muted">
                                        Last activity: @snapshot.LastEventTime.Value.ToString("MMM dd, HH:mm:ss") UTC
                                    </small>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <!-- Event Tables -->
    <div class="row g-4">
        <!-- Recent Burns -->
        <div class="col-lg-6">
            <div class="section-header">
                <h4>Recent Burns</h4>
                <span class="badge bg-success">+Reserve</span>
            </div>
            <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
                <table class="table table-sm table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Contract</th>
                            <th>Amount</th>
                            <th>From</th>
                            <th>Time</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_recentBurns.Count == 0)
                        {
                            <tr>
                                <td colspan="4" class="text-center text-muted py-4">No burn events yet</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var burn in _recentBurns)
                            {
                                <tr class="event-row">
                                    <td>
                                        <span class="badge bg-info me-1">#@burn.ContractIndex</span>
                                        @ContractInfoService.GetDisplayName(burn.ContractIndex)
                                    </td>
                                    <td class="text-success mono">+@FormatAmount(burn.Amount)</td>
                                    <td class="text-muted small mono">@TruncateAddress(burn.PublicKey)</td>
                                    <td class="text-muted small">@burn.Timestamp.ToString("HH:mm:ss")</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Recent Deductions -->
        <div class="col-lg-6">
            <div class="section-header">
                <h4>Recent Deductions</h4>
                <span class="badge bg-danger">-Reserve</span>
            </div>
            <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
                <table class="table table-sm table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Contract</th>
                            <th>Deducted</th>
                            <th>Remaining</th>
                            <th>Time</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_recentDeducts.Count == 0)
                        {
                            <tr>
                                <td colspan="4" class="text-center text-muted py-4">No deduction events yet</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var deduct in _recentDeducts)
                            {
                                <tr class="event-row">
                                    <td>
                                        <span class="badge bg-info me-1">#@deduct.ContractIndex</span>
                                        @ContractInfoService.GetDisplayName(deduct.ContractIndex)
                                    </td>
                                    <td class="text-danger mono">-@FormatAmount(deduct.DeductedAmount)</td>
                                    <td class="text-muted mono">@FormatAmount(deduct.RemainingAmount)</td>
                                    <td class="text-muted small">@deduct.Timestamp.ToString("HH:mm:ss")</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@code {
    private List<ReserveSnapshot> _snapshots = new();
    private List<BurnEvent> _recentBurns = new();
    private List<DeductEvent> _recentDeducts = new();
    private bool _loading = true;
    private string? _error;
    private HubConnection? _hubConnection;
    private int _currentEpoch;
    private long _totalBurned;
    private long _totalDeducted;
    private long _netChange;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
        await SetupSignalRAsync();
    }

    private async Task LoadDataAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _snapshots = await ReserveService.GetAllReserveSnapshotsAsync();
            _recentBurns = await ReserveService.GetRecentBurnEventsAsync(limit: 20);
            _recentDeducts = await ReserveService.GetRecentDeductEventsAsync(limit: 20);

            // Calculate totals
            _totalBurned = _snapshots.Sum(s => s.TotalBurned);
            _totalDeducted = _snapshots.Sum(s => s.TotalDeducted);
            _netChange = _totalBurned - _totalDeducted;

            // Get current epoch from recent events
            if (_recentBurns.Any())
                _currentEpoch = _recentBurns.Max(b => b.Epoch);
            else if (_recentDeducts.Any())
                _currentEpoch = _recentDeducts.Max(d => d.Epoch);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SetupSignalRAsync()
    {
        _hubConnection = new HubConnectionBuilder()
            .WithUrl(NavigationManager.ToAbsoluteUri("/reserveHub"))
            .WithAutomaticReconnect()
            .Build();

        _hubConnection.On<BurnEvent>("OnBurnEvent", async (burnEvent) =>
        {
            _recentBurns.Insert(0, burnEvent);
            if (_recentBurns.Count > 20)
            {
                _recentBurns.RemoveAt(_recentBurns.Count - 1);
            }

            _currentEpoch = Math.Max(_currentEpoch, burnEvent.Epoch);
            _totalBurned += burnEvent.Amount;
            _netChange = _totalBurned - _totalDeducted;

            // Update snapshot for this contract
            await UpdateSnapshotAsync(burnEvent.ContractIndex);
            await InvokeAsync(StateHasChanged);
        });

        _hubConnection.On<DeductEvent>("OnDeductEvent", async (deductEvent) =>
        {
            _recentDeducts.Insert(0, deductEvent);
            if (_recentDeducts.Count > 20)
            {
                _recentDeducts.RemoveAt(_recentDeducts.Count - 1);
            }

            _currentEpoch = Math.Max(_currentEpoch, deductEvent.Epoch);
            _totalDeducted += deductEvent.DeductedAmount;
            _netChange = _totalBurned - _totalDeducted;

            // Update snapshot for this contract
            await UpdateSnapshotAsync(deductEvent.ContractIndex);
            await InvokeAsync(StateHasChanged);
        });

        try
        {
            await _hubConnection.StartAsync();
        }
        catch (Exception)
        {
            // SignalR connection failed, continue without real-time updates
        }
    }

    private async Task UpdateSnapshotAsync(int contractIndex)
    {
        var updatedSnapshot = await ReserveService.GetReserveSnapshotAsync(contractIndex);
        if (updatedSnapshot != null)
        {
            var existingIndex = _snapshots.FindIndex(s => s.ContractIndex == contractIndex);
            if (existingIndex >= 0)
            {
                _snapshots[existingIndex] = updatedSnapshot;
            }
            else
            {
                _snapshots.Add(updatedSnapshot);
                _snapshots = _snapshots.OrderBy(s => s.ContractIndex).ToList();
            }
        }
    }

    private static string FormatAmount(long amount)
    {
        if (amount >= 1_000_000_000_000)
            return $"{amount / 1_000_000_000_000.0:F2}T";
        if (amount >= 1_000_000_000)
            return $"{amount / 1_000_000_000.0:F2}B";
        if (amount >= 1_000_000)
            return $"{amount / 1_000_000.0:F2}M";
        if (amount >= 1_000)
            return $"{amount / 1_000.0:F2}K";
        return amount.ToString("N0");
    }

    private static string TruncateAddress(string address)
    {
        if (string.IsNullOrEmpty(address) || address.Length <= 12)
            return address;
        return $"{address[..6]}...{address[^6..]}";
    }

    public async ValueTask DisposeAsync()
    {
        if (_hubConnection is not null)
        {
            await _hubConnection.DisposeAsync();
        }
    }
}
